#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define NAV_NUM 1
#define FN_SYM 2
#define TAPPING_TERM_MS 200

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <TAPPING_TERM_MS>;
    quick-tap-ms = <TAPPING_TERM_MS>;
};

/ {
    behaviors {
        // LGUI_T(KC_NO) must remain silent on tap.
        gui_hold: gui_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM_MS>;
            quick-tap-ms = <TAPPING_TERM_MS>;
            bindings = <&kp>, <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E      &kp R &kp T    &kp Y &kp U &kp I     &kp O   &kp P    &kp EQUAL
                &kp LSHFT &kp A &kp S &mt LALT D &kp F &kp G    &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
                &kp LCTRL &kp Z &kp X &kp C      &kp V &kp B    &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp MINUS
                            &gui_hold LGUI 0 &kp SPACE &mo NAV_NUM    &kp RET &kp BSPC &mo FN_SYM
            >;
        };

        nav_num_layer {
            display-name = "Nav/Num";
            bindings = <
                &kp LG(LS(S)) &trans &trans   &kp UP   &trans    &trans    &kp N7 &kp N8 &kp N9 &none     &none    &kp ESC
                &trans       &trans &kp LEFT &kp DOWN &kp RIGHT &trans    &kp N4 &kp N5 &kp N6 &kp EQUAL &kp SEMI &kp SQT
                &kp LSHFT    &trans &trans   &trans   &trans    &trans    &kp N1 &kp N2 &kp N3 &kp RBKT  &kp FSLH &kp BSLH
                                            &trans &trans &trans    &kp N0 &trans &trans
            >;
        };

        fn_sym_layer {
            display-name = "Fn/Sym";
            bindings = <
                &trans &kp F1 &kp F2  &kp F3  &kp F4  &trans    &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp LBKT &kp RBKT
                &trans &kp F5 &kp F6  &kp F7  &kp F8  &trans    &kp LS(N4) &kp LS(N5) &kp LS(N6) &trans     &trans   &kp GRAVE
                &trans &kp F9 &kp F10 &kp F11 &kp F12 &trans    &kp LS(N1) &kp LS(N2) &kp LS(N3) &trans     &trans   &trans
                              &trans &kp LS(BSPC) &kp LG(SPACE)    &trans &trans &trans
            >;
        };
    };
};
